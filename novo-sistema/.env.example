# ==========================================================================
# Sistema da Barbearia — variaveis de ambiente
#
# Copie para .env e preencha. NUNCA versione o .env.
# Nenhum valor abaixo e segredo real: campos sensiveis ficam VAZIOS aqui.
#
# Ambientes (APP_ENV):
#   local       desenvolvimento na maquina do dev
#   testing     testes automatizados (definido em phpunit.xml)
#   homologacao ambiente de validacao com dados anonimizados
#   production  producao
# ==========================================================================

APP_NAME="Barbearia"
APP_ENV=local
# Gere com: php artisan key:generate
APP_KEY=
# Em producao/homologacao: false
APP_DEBUG=true
# URL publica FIXA. Links de e-mail (reset de senha, confirmacoes) usam
# SEMPRE este valor, nunca o cabecalho Host da requisicao.
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Barbearia ------------------------------------------------------------
BARBEARIA_TIMEZONE=America/Sao_Paulo
BARBEARIA_CURRENCY=BRL
# Paginas de referencia /prototipos e /design-system (so dados de exemplo).
# true em local e homologacao; false em producao.
BARBEARIA_PROTOTYPES=true

# --- Contas e acesso (Fase 3; ver docs/reconstrucao/seguranca-contas.md) ---
# Tentativas de login por minuto por conta + IP (por IP: 6x este valor).
LOGIN_MAX_ATTEMPTS=5
# Pedidos de e-mail (redefinicao, link magico) por IP a cada 10 minutos.
AUTH_EMAIL_REQUESTS_PER_IP=10
# Cadastros de cliente por IP por hora.
AUTH_REGISTRATIONS_PER_IP=5
# Validade do link magico do cliente e do link de confirmacao de e-mail (minutos).
AUTH_MAGIC_LINK_MINUTES=15
AUTH_EMAIL_VERIFICATION_MINUTES=1440
# "Manter conectado": equipe 14 dias, clientes 30 dias (minutos).
AUTH_STAFF_REMEMBER_MINUTES=20160
AUTH_CUSTOMER_REMEMBER_MINUTES=43200
# Reconfirmar a senha antes de gerenciar usuarios (segundos).
AUTH_PASSWORD_TIMEOUT=900

# --- Logs -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14
LOG_JOBS_DAYS=30
LOG_SECURITY_DAYS=90
LOG_DEPRECATIONS_CHANNEL=null

# --- Banco de dados -------------------------------------------------------
# Padrao: SQLite (arquivo database/database.sqlite). Ver decisoes-fase-1.md.
DB_CONNECTION=sqlite
# DB_DATABASE=/caminho/absoluto/database.sqlite
# Para MySQL/MariaDB (se decidido):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=barbearia
# DB_USERNAME=
# DB_PASSWORD=

# --- Sessao ---------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Em producao/homologacao (HTTPS): true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- Cache ----------------------------------------------------------------
CACHE_STORE=database
# CACHE_PREFIX=

# --- Filas e agendador ----------------------------------------------------
QUEUE_CONNECTION=database
# true: o cron do agendador processa a fila a cada minuto (hospedagem
# compartilhada). false: use um worker supervisionado (VPS).
QUEUE_WORK_VIA_SCHEDULER=true
SCHEDULER_HEARTBEAT_TOLERANCE=5

# --- E-mail ---------------------------------------------------------------
# local: "log" grava os e-mails em storage/logs. Producao: smtp (ou provedor
# transacional, decisao D-05).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="nao-responda@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Arquivos -------------------------------------------------------------
FILESYSTEM_DISK=local

# --- Integracoes (preenchidas nas fases correspondentes) ------------------
# Stripe (Fase 9, se aprovada). Deixe vazio ate la.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Frontend -------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
